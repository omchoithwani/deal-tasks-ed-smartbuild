HUBSPOT_ACCESS_TOKEN=          # HubSpot Private App token
RESEND_API_KEY=                # Resend API key (from resend.com)
FROM_EMAIL=                    # Verified sender domain, e.g. reports@yourdomain.com
RECIPIENT_EMAILS=              # Comma-separated: alice@example.com,bob@example.com
HUBSPOT_PROPOSAL_PROPERTY=proposal_submission_date  # Internal HubSpot deal property name
HUBSPOT_OWNER_ID=1517615118,9876543210              # Comma-separated HubSpot owner IDs
HUBSPOT_PORTAL_ID=                                  # Your HubSpot portal ID (found in any HubSpot URL, e.g. app.hubspot.com/contacts/47530880/...)
